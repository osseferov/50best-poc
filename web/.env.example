# PUBLIC (ships in the browser bundle). Directus instance URL; leave empty to run on the bundled mock data.
# Used as the "Directus is on" flag, to recognise embedded asset URLs and by the Visual Editor.
VITE_DIRECTUS_URL=
# SECRET, server-only: no VITE_ prefix so it is never inlined into the client bundle.
# Used only by the server functions in api/ + server/ (Vercel functions; the Vite dev server runs them locally).
# Use the narrowest read-only role that works.
# Set it in Vercel project env vars (not committed). DIRECTUS_URL is optional, it falls back to VITE_DIRECTUS_URL.
DIRECTUS_TOKEN=
DIRECTUS_URL=
# Google Maps Platform key with Places API (New) enabled — venue Key Information is fetched live.
# Restrict it by HTTP referrer in Google Cloud: it ships in the browser bundle.
VITE_GOOGLE_MAPS_KEY=
