# Directus instance. Leave empty to run on the bundled mock data.
VITE_DIRECTUS_URL=
# Optional static token for a non-public role (sent as Bearer).
VITE_DIRECTUS_TOKEN=
# Google Maps Platform key with Places API (New) enabled — venue Key Information is fetched live.
# Restrict it by HTTP referrer in Google Cloud: it ships in the browser bundle.
VITE_GOOGLE_MAPS_KEY=
