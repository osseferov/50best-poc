# ── SERVER-ONLY (runtime). No VITE_ prefix, so they are never inlined into the browser bundle. ──
# Directus instance. Leave DIRECTUS_URL or DIRECTUS_TOKEN empty to run on the bundled mock data.
DIRECTUS_URL=
# Use the narrowest read-only role that works (discovery_landing, establishment, story, published_ranking, ranking + directus_files).
DIRECTUS_TOKEN=
# Google Places API (New) key for venue Key Information. Server-side: restrict by API (Places) / IP, not by referrer.
GOOGLE_MAPS_KEY=
# Port for `npm start` / Docker (default 3000).
PORT=

# ── PUBLIC (build time, ships in the browser bundle) ──
# Google Maps Embed API key for the venue map. Restrict it by HTTP referrer in Google Cloud.
VITE_GOOGLE_MAPS_KEY=
